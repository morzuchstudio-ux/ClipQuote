{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/c/:id", "destination": "/api/share?id=:id" }],
  "functions": { "api/**/*.js": { "maxDuration": 15, "includeFiles": "dist/index.html" } }
}
